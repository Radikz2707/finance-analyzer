# http://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

[package.json]
indent_size = 2

[*.{ts,tsx}]
indent_style = space
indent_size = 2
quote_type = single
