{
  "name": "finance-analyzer",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "AI-Platform for financial analysis and portfolio rebalancing",
  "sideEffects": [
    "src/js/app.ts",
    "desktop/load-settings.ts",
    "desktop/load-settings.js"
  ],
  "author": "Радик Залалов",
  "license": "ISC",
  "main": "desktop/dist/main.cjs",
  "scripts": {
    "admin": "npx @staticcms/proxy-server",
    "dev": "node --import tsx scripts/dev-launcher.ts",
    "start": "cross-env NODE_NO_WARNINGS=1 G_MESSAGES_DEBUG=none node --max-old-space-size=4096 node_modules/gulp/bin/gulp.js start",
    "build": "npm run test:run && gulp build",
    "init": "gulp --gulpfile gulp/system/gulp.init.js init",
    "create": "gulp --gulpfile gulp/system/gulp.create.js create",
    "module": "gulp --gulpfile gulp/system/gulp.module.js module",
    "plugin": "gulp --gulpfile gulp/system/gulp.plugin.js plugin",
    "remove": "gulp --gulpfile gulp/system/gulp.remove.js remove",
    "help": "gulp --gulpfile gulp/system/gulp.help.js help",
    "lint": "cross-env NODE_NO_WARNINGS=1 G_MESSAGES_DEBUG=none node --no-deprecation --max-old-space-size=4096 node_modules/gulp/bin/gulp.js lintJs lintCss && npx tsc --noEmit",
    "lint:gulp": "npx tsc -p gulp/tsconfig.json",
    "lint:fix": "npx stylelint \"src/**/*.scss\" --fix",
    "clean": "gulp cleandist",
    "update-modules": "npx npm-check-updates -i --no-cache && npm install --legacy-peer-deps",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "cross-env LANG=en_US.UTF-8 vitest run",
    "test:integration": "cross-env RUN_INTEGRATION=1 vitest run src/js/modules/integration-tests",
    "audit": "node gulp/run-audit.js && node gulp/generate-blueprint.js",
    "blueprint": "node gulp/generate-blueprint.js",
    "push": "git add . && git commit -m \"Updates\" && git push",
    "push:main": "git add . && git commit -m \"Updates\" && git push origin main",
    "cache:clear-ai": "node --import tsx scripts/clear-ai-cache.ts",
    "bench": "node --import tsx src/js/modules/pipeline/benchmarks/run.ts",
    "harness": "node --import tsx scripts/harness-start.ts",
    "chat": "node --import tsx scripts/director-chat.ts",
    "pipeline": "cross-env NODE_NO_WARNINGS=1 G_MESSAGES_DEBUG=none node --max-old-space-size=4096 node_modules/gulp/bin/gulp.js pipeline",
    "pipeline:schedule": "node --import tsx pipeline.ts schedule",
    "app:build:js": "node desktop/build.mjs",
    "app:dev": "npm run app:build:js && node desktop/run-dev.mjs",
    "app:dev:offline": "cross-env DIRECTOR_CHAT_AI=off npm run app:dev",
    "app:rebuild": "node desktop/run-rebuild.mjs",
    "app:typecheck": "tsc -p desktop/tsconfig.json --noEmit",
    "app:build": "npm run app:build:js && npm run app:rebuild && electron-builder --win --config desktop/electron-builder.yml",
    "app:build:dir": "npm run app:build:js && npm run app:rebuild && electron-builder --win dir --config desktop/electron-builder.yml",
    "release:patch": "npm version patch && npm run app:build",
    "release:minor": "npm version minor && npm run app:build",
    "release:major": "npm version major && npm run app:build"
  },
  "lint-staged": {
    "src/**/*.scss": "npx stylelint --fix"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/browser-sync": "^2.29.1",
    "@types/gulp": "^4.0.18",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "aos": "^2.3.4",
    "autoprefixer": "^10.6.1",
    "browser-sync": "^3.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.6",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "gulp": "^5.0.1",
    "gulp-cache": "^1.1.3",
    "gulp-clean-css": "^4.3.0",
    "gulp-file-include": "^2.3.0",
    "gulp-flatten": "^0.4.0",
    "gulp-fonter": "^0.3.0",
    "gulp-html-beautify": "^1.0.1",
    "gulp-htmlhint": "^4.0.2",
    "gulp-newer": "^1.4.0",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-sass": "^6.0.1",
    "gulp-svg-sprite": "^2.0.3",
    "gulp-ttf2woff2": "^5.0.0",
    "gulp-zip": "^6.1.0",
    "htmlhint-stylish": "^1.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "postcss-sort-media-queries": "^6.7.1",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-formatter-pretty": "^4.0.1",
    "stylelint-order": "^8.1.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vinyl-ftp": "^0.6.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "webp-in-css": "^0.9.0",
    "webpack": "^5.111.1",
    "webpack-stream": "^7.0.0"
  },
  "browserslist": [
    "defaults",
    "not ie 11"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "better-sqlite3@13.0.3": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "open": "^11.0.4",
    "xlsx": "^0.18.5"
  }
}
