{
  "name": "finance-analyzer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-Platform for financial analysis and portfolio rebalancing",
  "sideEffects": [
    "src/js/app.ts"
  ],
  "author": "",
  "license": "ISC",
  "scripts": {
    "admin": "npx @staticcms/proxy-server",
    "dev": "cross-env NODE_NO_WARNINGS=1 G_MESSAGES_DEBUG=none gulp",
    "build": "npm run test:run && gulp build",
    "init": "gulp --gulpfile gulp/system/gulp.init.js init",
    "create": "gulp --gulpfile gulp/system/gulp.create.js create",
    "module": "gulp --gulpfile gulp/system/gulp.module.js module",
    "remove": "gulp --gulpfile gulp/system/gulp.remove.js remove",
    "help": "gulp --gulpfile gulp/system/gulp.help.js help",
    "lint": "cross-env NODE_NO_WARNINGS=1 G_MESSAGES_DEBUG=none node --no-deprecation node_modules/gulp/bin/gulp.js lintJs lintCss",
    "lint:fix": "npx stylelint \"src/**/*.scss\" --fix",
    "clean": "gulp cleandist",
    "update-modules": "npx npm-check-updates -i --no-cache && npm install --legacy-peer-deps",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "cross-env LANG=en_US.UTF-8 vitest run",
    "audit": "node run-audit.js",
    "blueprint": "node generate-blueprint.js",
    "push:main": "git add . && git commit -m \"Updates\" && git push origin main"
  },
  "lint-staged": {
    "src/**/*.scss": "npx stylelint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@testing-library/dom": "^10.4.1",
    "@types/aos": "^3.0.8",
    "@types/browser-sync": "^2.29.1",
    "@types/gulp": "^4.0.18",
    "@types/node": "^26.4.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "ajv": "^8.20.0",
    "aos": "^2.3.4",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.5.4",
    "browser-sync": "^3.0.4",
    "cross-env": "^10.1.0",
    "decap-cms": "^3.16.0",
    "dotenv": "^17.4.2",
    "esbuild-loader": "^4.5.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "globals": "^17.11.0",
    "gray-matter": "^4.0.3",
    "gulp": "^5.0.1",
    "gulp-cache": "^1.1.3",
    "gulp-clean-css": "^4.3.0",
    "gulp-file-include": "^2.3.0",
    "gulp-flatten": "^0.4.0",
    "gulp-fonter": "^0.3.0",
    "gulp-html-beautify": "^1.0.1",
    "gulp-htmlhint": "^4.0.2",
    "gulp-if": "^3.0.0",
    "gulp-markdown": "^8.0.0",
    "gulp-newer": "^1.4.0",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-sass": "^6.0.1",
    "gulp-sitemap": "^8.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-svg-sprite": "^2.0.3",
    "gulp-ttf2woff2": "^5.0.0",
    "gulp-zip": "^6.1.0",
    "htmlhint-stylish": "^1.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "mammoth": "^1.12.2",
    "postcss": "^8.5.26",
    "postcss-sort-media-queries": "^6.7.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.103.1",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-formatter-pretty": "^4.0.1",
    "stylelint-order": "^8.1.1",
    "terser-webpack-plugin": "^5.6.1",
    "through2": "^5.0.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vinyl-ftp": "^0.6.1",
    "vitest": "^4.1.11",
    "webp-in-css": "^0.9.0",
    "webpack": "^5.110.2",
    "webpack-stream": "^7.0.0",
    "yaml": "^2.9.0"
  },
  "browserslist": [
    "defaults",
    "not ie 11"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "ttf2woff2@6.0.1": true,
    "core-js@3.49.0": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "@staticcms/core": "^4.3.0",
    "xlsx": "^0.18.5"
  }
}
