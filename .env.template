# ============================================
# ПУТИ К ДАННЫМ
# ============================================

# Путь к Excel-файлу с данными портфеля QUIK
EXCEL_FILE_PATH=/path/to/your/portfolio.xlsx

# Папка с экспортированными данными QUIK (новости + заявки).
# По умолчанию: <корень проекта>/data/quik
QUIK_NEWS_DIR=/path/to/finance-analyzer/data/quik
QUIK_ORDERS_DIR=/path/to/finance-analyzer/data/quik

# ============================================
# TELEGRAM-УВЕДОМЛЕНИЯ (Пакет улучшений 1)
# ============================================

# Токен бота из BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=ваш_токен_от_BotFather
# ID чата для уведомлений (приоритет над TELEGRAM_ADMIN_IDS)
TELEGRAM_CHAT_ID=
# Fallback: список admin-чатов через запятую (используется первый)
TELEGRAM_ADMIN_IDS=ваш_telegram_id

# ============================================
# ИИ-АГЕНТЫ ДЛЯ ФИНАНСОВОГО АНАЛИЗА
# ============================================

# OpenRouter API (Claude Sonnet 4, GPT-4o и другие модели)
# Получить ключ: https://openrouter.ai/keys
# Рекомендуется для лучшего качества анализа
OPENROUTER_API_KEY=your-openrouter-api-key-here

# GigaChat API (Сбер) — работает в РФ без VPN!
# Получить ключ: https://developer.sber.ru/tech/calculators/gigachat
# Бесплатно до 1000 запросов/день
GIGACHAT_API_KEY=ваш_gigachat_ключ

# Scope GigaChat (опционально): GIGACHAT_API_PERS (песочница, по умолчанию)
# или GIGACHAT_API_CORP (продакшен). Если ключ выдан для продакшена,
# а OAuth отвечает 403 — укажите GIGACHAT_API_CORP.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# YandexGPT API (Яндекс) — опционально
# Получить ключ: https://cloud.yandex.ru/services/yandexgpt
# Стартовый баланс 5000₽ в Yandex Cloud
YANDEXGPT_API_KEY=your-yandexgpt-api-key-here

# ============================================
# ВЫБОР МОДЕЛИ (опционально)
# ============================================
# По умолчанию: ollama (локально, бесплатно)
# Доступные модели:
#   - ollama (локально, бесплатно)
#   - gigachat (бесплатно, без VPN)
#   - gpt-4o (OpenRouter, нужен VPN + кредиты)
#   - yandexgpt (Яндекс Cloud, стартовый баланс 5000₽)
#
# Для переключения укажите нужную модель:
AI_MODEL_ID=ollama

# Имя локальной модели Ollama (используется во ВСЕХ местах: AI-конвейер,
# ревизоры, Director). Меняется только здесь — в коде жёстко зашитых имён нет.
# Посмотреть установленные: ollama list
#
# ⚠️ Требования к памяти (проверено: RTX 4050 Laptop 6 ГБ VRAM + 16 ГБ RAM):
#   - qwen3.5:9b (6.6 ГБ) — РАБОТАЕТ (дефолт);
#   - qwen3.6:27b-q4_K_M (17.4 ГБ) — НЕ РАБОТАЕТ: не влезает в VRAM/RAM,
#     Ollama падает с «failed to allocate CUDA_Host buffer». Нужно ≥ 32 ГБ RAM.
OLLAMA_MODEL=qwen3.5:9b

# ============================================
# AI CACHE (опционально)
# ============================================
# true — кэш работает (по умолчанию)
# false — отключить кэш для разработки
AI_CACHE_ENABLED=true

# ============================================
# PROXY API (опционально)
# ============================================
# Ключ прокси-сервиса для обхода ограничений
PROXYAPI_KEY=ваш_proxy_api_key
